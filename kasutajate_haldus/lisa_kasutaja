#!/bin/bash
#
# lisa_kasutaja - kasutaja lisamise skript (Ülesanne 1)
# Kasutaja nimi antakse skriptile parameetrina. Skript loob antud nimega
# kasutaja (ilma paroolita) ja kodukataloogi /home/kasutajanimi, kuhu
# kopeeritakse /etc/skel sisu (peidetud failid .bashrc .profile .bash_logout)
#
# Kasutamine: sudo sh lisa_kasutaja kasutajanimi
#

# parameetrite arv on muutujas $#, peab olema täpselt 1 (kasutajanimi)
# kui parameeter puudub - kuvame kasutusjuhendi ja lõpetame töö
if [ $# -ne 1 ]; then
    echo "Kasutusjuhend: $0 kasutajanimi"
    exit 1
fi

# kasutajanimi on esimene parameeter
kasutajanimi=$1

# kontrollime, kas selline kasutaja on juba olemas
if id "$kasutajanimi" > /dev/null 2>&1; then
    echo "Kasutaja $kasutajanimi on juba olemas"
    exit 1
fi

# lisame kasutaja vajalike võtmetega:
#   -m  loob kodukataloogi ja kopeerib sinna /etc/skel sisu
#   -d  kodukataloogi asukoht /home/kasutajanimi
#   -s  kasutaja käsukest (koorik) /bin/bash
useradd "$kasutajanimi" -m -d "/home/$kasutajanimi" -s /bin/bash
kasu_tulemus=$?

# kontrollime, kas useradd käsk õnnestus (väljundkood 0 = OK)
if [ $kasu_tulemus -eq 0 ]; then
    echo "Kasutaja nimega $kasutajanimi on lisatud süsteemi"
    grep "^$kasutajanimi:" /etc/passwd
    ls -la "/home/$kasutajanimi"
else
    echo "Probleem kasutaja $kasutajanimi lisamisega"
    echo "useradd väljundkood: $kasu_tulemus"
    exit $kasu_tulemus
fi
